[Unit]
Description=ThrottlerOS & SYSmin Localhost Process Throttler
After=network.target

[Service]
Type=simple
User=%I
WorkingDirectory=/opt/throttleros
ExecStart=/opt/throttleros/.venv/bin/python3 -m backend.main --host 0.0.0.0 --port 8742 --no-browser
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target

